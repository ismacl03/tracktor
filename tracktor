    # ── clusters: background queries ──
    def cluster(self, name):
        return next((c for c in self.clusters if c["name"] == name), None)

    def poll_cluster(self, c, force=False):
        s = self.cstate.setdefault(c["name"], ClusterState())
        if s.busy or (not force and time.time() - s.t < c.get("every", CLUSTER_EVERY_DEFAULT)):
            return
        s.busy = True
        since = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(max(time.time() - cset(c, "hist_days") * 86400,
                                                                       c.get("cleared", 0))))

        def run():
            try:
                ok, out, err = ssh_run(c["host"], poll_script(since), pre=c.get("pre", ""))
                if ok:
                    s.running, s.hist, s.starts = parse_poll(out)
                s.ok, s.err = ok, ("" if ok else err)
            except Exception as e:
                s.ok, s.err = False, str(e)
            s.t, s.busy, s.first = time.time(), False, False
        threading.Thread(target=run, daemon=True).start()

    def fetch_cluster_log(self, name, jid, running, stream):
        c, s = self.cluster(name), self.cstate.get(name)
        k = (jid, stream)
        if not c or not s or k in s.log_busy:
            return
        old = s.logs.get(k)
        if old and (not running or time.time() - old[1] < cset(c, "cluster_log_every")):
            return
        s.log_busy.add(k)

        def run():
            try:
                paths = s.log_paths.get(jid)
                if not paths:
                    try:
                        paths = resolve_logs(c["host"], c.get("pre", ""), [jid], live=running, check=True).get(jid)
                    except OSError as e:
                        s.logs[k] = (f"(no connection to {name}: {e})", time.time()); return
                    if not paths:
                        s.logs[k] = ("(log not found: Slurm no longer remembers this job)", time.time())
                        return
                    s.log_paths[jid] = paths
                f = shlex.quote(paths[stream])
                ok, out, err = ssh_run(c["host"], f"if [ -e {f} ]; then tail -c {tail_bytes()} {f} 2>&1; "
                                       f"else echo @@NOLOG; fi", timeout=60, pre=c.get("pre", ""))
                if not ok:
                    text = f"(no connection to {name}: {err})"
                elif out.strip() == "@@NOLOG":
                    s.log_paths.pop(jid, None)     # look for it again next time (it may not have been created yet)
                    text = (f"(this log does not exist on {name}: it was deleted or moved, or the job has not "
                            f"written it yet)\n\n{paths[stream]}")
                else:
                    text = clean_log(out)
                s.logs[k] = (text, time.time())
            finally:
                s.log_busy.discard(k)
        threading.Thread(target=run, daemon=True).start()

    def fetch_eff(self, name, jid):
        """Efficiency (like seff) of a finished job, in the background and only once."""
        c, s = self.cluster(name), self.cstate.get(name)
        if not c or not s or jid in s.eff or jid in s.eff_busy:
            return
        s.eff_busy.add(jid)

        def run():
            try:
                ok, out, err = ssh_run(c["host"], eff_script(jid), timeout=30, pre=c.get("pre", ""))
                if ok:
                    s.eff[jid] = parse_eff(out) or "Efficiency: Slurm has no data for this job"
            finally:
                s.eff_busy.discard(jid)
        threading.Thread(target=run, daemon=True).start()

    def cluster_paths(self, info):
        s = self.cstate.get(info.get("cluster")) if info else None
        return s.log_paths.get(info["id"]) if s else None

    def set_stream_buttons(self, info):
        """Output/errors buttons: only for cluster jobs; errors disabled if both go to the same file."""
        is_cl = bool(info) and info["kind"] == "cluster"
        self.out_btn.setVisible(is_cl); self.err_btn.setVisible(is_cl)
        if not is_cl:
            return
        paths = self.cluster_paths(info)
        same = bool(paths) and paths["out"] == paths["err"]
        self.err_btn.setEnabled(not same)
        self.err_btn.setToolTip("This job writes its errors to the same file as its output (Slurm's default when "
                                "--error is not used)" if same else (paths["err"] if paths else ""))
        self.out_btn.setToolTip(paths["out"] if paths else "")
        stream = "out" if same else self.stream
        (self.out_btn if stream == "out" else self.err_btn).setChecked(True)

    def set_stream(self, stream):
        if stream != self.stream:
            self.stream = stream
            if self._cur_tab in self.tabdata:
                self.tabdata[self._cur_tab]["stream"] = stream
            if self.sel:
                self.select(self.sel)

    # ── selection and log ──
    def select(self, info):
        if not info:
            return
        self.sel = info
        extra = ""
        if info["kind"] == "local":
            where = info["log"]
        elif info["kind"] == "array":
            where = f"{info['cluster']}  ·  array {info['id']}"
        else:
            paths = self.cluster_paths(info)
            where = f"{info['cluster']}  ·  job {info['id']}" + (f"  ·  {paths[self.eff_stream()]}" if paths else "")
            if not info.get("running"):
                self.fetch_eff(info["cluster"], info["id"])
                st = self.cstate.get(info["cluster"])
                extra = (st.eff.get(info["id"]) if st else "") or ""
        self._title_paths = self.cluster_paths(info) if info["kind"] == "cluster" else None
        self._title_eff = extra
        self.title.setText(f"<b>{html.escape(info['label'])}</b>  —  {html.escape(where)}<br>"
                           f"<small>{html.escape(info.get('cmd', ''))}</small>"
                           + (f"<br><small>{extra}</small>" if extra else ""))
        self.set_stream_buttons(info)
        self.show_log(force=True)

    def eff_stream(self):
        paths = self.cluster_paths(self.sel)
        return "out" if (paths and paths["out"] == paths["err"]) else self.stream

    def current_log_text(self):
        i = self.sel
        if i["kind"] == "local":
            return read_tail(i["log"])
        if i["kind"] == "array":
            return (f"Array {i['id']} ({len(i.get('ids', []))} tasks in this list).\n"
                    "Expand it and click a task to see its log.")
        st = self.eff_stream()
        self.fetch_cluster_log(i["cluster"], i["id"], i.get("running", False), st)
        s = self.cstate.get(i["cluster"])
        got = s.logs.get((i["id"], st)) if s else None
        return got[0] if got else "(reading the log from the cluster…)"

    def show_log(self, force=False):
        if not self.sel:
            return
        sb = self.out.verticalScrollBar()
        at_bottom = sb.value() >= sb.maximum() - 3
        txt = self.current_log_text()
        if force or txt != self.out.toPlainText():
            pos = sb.value()
            self.out.setPlainText(txt)
            if self.searching():                 # while searching: do not jump to the end, stay where we were
                if not force:
                    sb.setValue(pos)
                self.update_find(jump=force)
            elif force or at_bottom:
                self.out.moveCursor(QTextCursor.MoveOperation.End)
            else:
                sb.setValue(pos)
        if self.sel["kind"] == "cluster":
            st = self.cstate.get(self.sel["cluster"])
            eff = (st.eff.get(self.sel["id"]) if st and not self.sel.get("running") else "") or ""
            if self.cluster_paths(self.sel) != self._title_paths or eff != self._title_eff:
                self.select(self.sel)   # paths or efficiency are now known: update title and buttons

    # ── log search ──
    def searching(self):
        return self.findbar.isVisible() and bool(self.find_edit.text())

    def open_find(self):
        self.findbar.show(); self.find_edit.setFocus(); self.find_edit.selectAll()
        self.update_find(jump=True)

    def close_find(self):
        self.findbar.hide(); self.matches, self.find_idx = [], -1
        self.out.setExtraSelections([]); self.find_count.setText("")

    def update_find(self, jump=False):
        q = self.find_edit.text()
        if not q or not self.findbar.isVisible():
            self.matches = []; self.out.setExtraSelections([]); self.find_count.setText(""); return
        doc = self.out.toPlainText().lower()
        self.matches = [m.start() for m in re.finditer(re.escape(q.lower()), doc)][:5000]
        if not self.matches:
            self.find_idx = -1; self.out.setExtraSelections([])
            self.find_count.setText("no matches"); return
        if jump or self.find_idx < 0:
            top = self.out.cursorForPosition(self.out.viewport().rect().topLeft()).position()
            self.find_idx = next((i for i, p in enumerate(self.matches) if p >= top), 0)
            self.go_match(self.find_idx)
        else:
            self.find_idx = min(self.find_idx, len(self.matches) - 1)
            self.paint_matches()

    def find_step(self, d):
        if not self.matches:
            self.update_find(jump=True); return
        self.go_match((self.find_idx + d) % len(self.matches))

    def go_match(self, i):
        self.find_idx = i
        n = len(self.find_edit.text()); cur = QTextCursor(self.out.document())
        cur.setPosition(self.matches[i]); cur.setPosition(self.matches[i] + n, QTextCursor.MoveMode.KeepAnchor)
        self.out.setTextCursor(cur); self.out.ensureCursorVisible()
        self.paint_matches()

    def paint_matches(self):
        n = len(self.find_edit.text()); sels = []
        for i, p in enumerate(self.matches[:2000]):
            sel = QTextEdit.ExtraSelection(); cur = QTextCursor(self.out.document())
            cur.setPosition(p); cur.setPosition(p + n, QTextCursor.MoveMode.KeepAnchor); sel.cursor = cur
            sel.format.setBackground(QColor("#ff9632" if i == self.find_idx else "#f5e663"))
            sel.format.setForeground(QColor("black"))
            sels.append(sel)
        self.out.setExtraSelections(sels)
        self.find_count.setText(f"{self.find_idx + 1}/{len(self.matches)}")

    # ── building the trees ──
    # Groups open/close by clicking their header (▸/▾).  Everything starts collapsed.
    def group_clicked(self, it, col=0):
        p = it.data(0, Qt.ItemDataRole.UserRole)
        is_group = it.data(0, Qt.ItemDataRole.UserRole + 1) and not p
        if (is_group or (p and p.get("kind") == "array")) and col not in it.treeWidget()._xcols:
            it.setExpanded(not it.isExpanded())     # -> on_fold

    def on_current(self, t, it):
        """Selection: "Running" has two tables; selecting in one clears the selection of the other."""
        pairs = {self.run_l: self.run_c, self.run_c: self.run_l, self.hist_l: self.hist_c, self.hist_c: self.hist_l}
        if it is not None and t in pairs:
            other = pairs[t]
            other.blockSignals(True); other.setCurrentItem(None); other.clearSelection(); other.blockSignals(False)
        if it is not None:
            self.open_info(it.data(0, Qt.ItemDataRole.UserRole))

    # ── log tabs (like a browser): click = open in the current tab, double click = open in a new tab; a job that
    # is already open in a tab just brings that tab to the front ──
    @staticmethod
    def tab_title(info):
        return info["label"] if info["kind"] == "local" else f"{info['label']}  [{info['id']}]"

    @staticmethod
    def tab_tip(info):
        if info["kind"] == "local":
            return f"{info['label']}\n{info.get('log', '')}"
        return f"{info['label']}\n{info['cluster']}  ·  {'array' if info['kind'] == 'array' else 'job'} {info['id']}"

    def tab_index(self, tid):
        return next((i for i in range(self.logtabs.count()) if self.logtabs.tabData(i) == tid), -1)

    def find_tab(self, key):
        return next((i for i in range(self.logtabs.count())
                     if self.tabdata[self.logtabs.tabData(i)]["info"].get("key") == key), -1)

    def set_tab_info(self, i, info):
        self.logtabs.setTabText(i, self.tab_title(info)); self.logtabs.setTabToolTip(i, self.tab_tip(info))

    def open_info(self, info, new=False):
        if not info:
            return
        key, cur = info.get("key"), self.logtabs.currentIndex()
        i = self.find_tab(key)
        lr = self._last_replace
        if (new and lr and i == cur >= 0 and lr[0] == self.logtabs.tabData(cur) and lr[2] == key
                and time.time() - lr[3] < 2):
            # the first click of this double click put the job in the current tab: give that tab its log back
            self.tabdata[lr[0]].update(lr[1]); self.set_tab_info(cur, lr[1]["info"])
            self._last_replace, i = None, -1
        elif i >= 0:
            if i != cur:
                self.logtabs.setCurrentIndex(i)          # -> tab_changed
            return
        if new or cur < 0:
            self._tab_seq += 1; tid = self._tab_seq
            self.tabdata[tid] = dict(info=info, stream="out", scroll=None)
            self._last_replace = None
            self.logtabs.blockSignals(True)
            i = self.logtabs.addTab(""); self.logtabs.setTabData(i, tid); self.set_tab_info(i, info)
            self.logtabs.blockSignals(False)
        else:
            self.save_scroll()
            i, tid = cur, self.logtabs.tabData(cur)
            self._last_replace = (tid, dict(self.tabdata[tid]), key, time.time())
            self.tabdata[tid] = dict(info=info, stream="out", scroll=None)
            self.set_tab_info(i, info)
        if i != self.logtabs.currentIndex():
            self.logtabs.blockSignals(True); self.logtabs.setCurrentIndex(i); self.logtabs.blockSignals(False)
            self.save_scroll()
        self._cur_tab = None
        self.activate(i)

    def save_scroll(self):
        d = self.tabdata.get(self._cur_tab)
        if d:
            sb = self.out.verticalScrollBar()
            d["scroll"] = None if sb.value() >= sb.maximum() - 3 else sb.value()

    def tab_changed(self, i):
        tid = self.logtabs.tabData(i) if i >= 0 else None
        if tid is not None and tid == self._cur_tab:
            return                                       # same tab, only its position changed
        self.save_scroll()
        self.activate(i)

    def activate(self, i):
        if i < 0 or not self.logtabs.count():
            self._cur_tab = None; self.clear_selection(); return
        tid = self.logtabs.tabData(i); d = self.tabdata[tid]
        self._cur_tab = tid; self.stream = d["stream"]
        self.select(d["info"])
        if d["scroll"] is not None:
            self.out.verticalScrollBar().setValue(d["scroll"])

    def close_tab(self, i):
        if i < 0:
            return
        tid = self.logtabs.tabData(i)
        if tid == self._cur_tab:
            self._cur_tab = None
        self.tabdata.pop(tid, None)
        self._last_replace = None
        self.logtabs.removeTab(i)                        # -> tab_changed (another tab, or none)
        if not self.logtabs.count():
            self._cur_tab = None; self.clear_selection()

    def close_log_tabs(self, pred):
        for i in reversed(range(self.logtabs.count())):
            if pred(self.tabdata[self.logtabs.tabData(i)]["info"]):
                self.close_tab(i)

    def refresh_tabs(self):
        """Keep the jobs shown in the tabs up to date (e.g. a running job that has just finished)."""
        for i in range(self.logtabs.count()):
            tid = self.logtabs.tabData(i); d = self.tabdata[tid]; key = d["info"].get("key")
            p = None
            for t in (self.run_l, self.run_c, self.hist_l, self.hist_c):
                it = t._items.get(key)
                p = it.data(0, Qt.ItemDataRole.UserRole) if it is not None else None
                if p:
                    break
            if not p or p == d["info"]:
                continue
            if d["info"].get("running") and not p.get("running") and p["kind"] == "cluster":
                s = self.cstate.get(p["cluster"])         # it has just finished: read its log once more
                if s:
                    s.logs.pop((p["id"], "out"), None); s.logs.pop((p["id"], "err"), None)
            d["info"] = p; self.set_tab_info(i, p)
            if tid == self._cur_tab:
                self.sel = p

    def fit_local(self):
        self.fit_top(self.run_l); self.fit_top(self.hist_l)

    def fit_top(self, t):
        """The local table takes just the height of its rows (up to half the tab); the clusters table the rest."""
        if not self.clusters:
            t.setMinimumHeight(0); t.setMaximumHeight(16777215); return
        rows, stack = 0, [t.invisibleRootItem()]
        while stack:
            it = stack.pop()
            for i in range(it.childCount()):
                ch = it.child(i); rows += 1
                if ch.isExpanded():
                    stack.append(ch)
        rowh = t.sizeHintForRow(0) if t.topLevelItemCount() else t.fontMetrics().height() + 6
        rowh = max(rowh, t.fontMetrics().height() + 4)
        h = t.header().sizeHint().height() + max(rows, 1) * rowh + 2 * t.frameWidth() + 4
        h = min(h, max(120, int(self.tabs.height() * 0.5)))
        t.setMinimumHeight(h); t.setMaximumHeight(h)

    def on_fold(self, tab, it, folded):
        g = it.data(0, Qt.ItemDataRole.UserRole + 1)
        if g:                                       # every group opens and closes on its own
            (self.open_groups.discard if folded else self.open_groups.add)((tab, g))
            self.set_group_text(it)
            if it.treeWidget() in (self.run_l, self.hist_l):
                self.fit_local()
            self.place_hover()
            return
        k = it.data(0, Qt.ItemDataRole.UserRole + 3)
        if k is not None:
            (self.open_arrays.discard if folded else self.open_arrays.add)((tab, k))
            if it.treeWidget() in (self.run_l, self.hist_l):
                self.fit_local()
            self.place_hover()

    def update_columns(self, t, tab):
        t.setHeaderHidden(False)

    @staticmethod
    def set_group_text(gi):
        head = gi.data(0, Qt.ItemDataRole.UserRole + 2) or ""
        txt = ("▾  " if gi.isExpanded() else "▸  ") + head
        if gi.text(0) != txt:
            gi.setText(0, txt)

    def fill(self, t, tabname, groups, flat=None):
        """groups = [(group, header, rows)], row = (key, columns, payload, color[, children]).  Without clusters,
        no groups.  Updated in place: only the rows that change are removed/added (the list is not rebuilt and does
        not jump).  It is only rebuilt when the groups change (a cluster is added/removed)."""
        KEY = Qt.ItemDataRole.UserRole + 3
        if flat is None:
            flat = len(groups) == 1 and groups[0][0] == "Local"
        layout = (flat, [g for g, _, _ in groups])
        cur = t.currentItem(); cur_key = cur.data(0, KEY) if cur else None
        t.blockSignals(True)
        if layout != t._layout:
            t.clear(); t._items, t._groups, t._hover = {}, {}, None
            t.setRootIsDecorated(False)     # no Qt arrows on groups: click the header (▸/▾ in the text)
            if not flat:
                for g, head, _ in groups:
                    gi = QTreeWidgetItem(t, [head]); gi.setData(0, Qt.ItemDataRole.UserRole + 1, g)
                    gi.setToolTip(0, "Click to expand or collapse")
                    f = gi.font(0); f.setBold(True); gi.setFont(0, f)
                    gi.setFirstColumnSpanned(True)
                    gi.setChildIndicatorPolicy(QTreeWidgetItem.ChildIndicatorPolicy.ShowIndicator)
                    gi.setExpanded((tabname, g) in self.open_groups)
                    t._groups[g] = gi
            t._layout = layout
        for g, head, rows in groups:
            self._sync(t, tabname, t.invisibleRootItem() if flat else t._groups[g], rows)
        if cur_key is not None and cur_key in t._items and t.currentItem() is not t._items[cur_key]:
            t.setCurrentItem(t._items[cur_key])
        t.blockSignals(False)
        for g, head, rows in groups:
            if g in t._groups:
                t._groups[g].setData(0, Qt.ItemDataRole.UserRole + 2, head)
                self.set_group_text(t._groups[g])
            self._update(t, rows)
        self.update_columns(t, tabname)

    def _forget(self, t, it):
        t._items.pop(it.data(0, Qt.ItemDataRole.UserRole + 3), None)
        if t._hover is it:
            t._hover = None
        for i in range(it.childCount()):
            self._forget(t, it.child(i))

    def _sync(self, t, tab, parent, rows):
        KEY = Qt.ItemDataRole.UserRole + 3
        want = {r[0] for r in rows}
        for i in range(parent.childCount() - 1, -1, -1):        # remove rows that are gone
            ch = parent.child(i)
            if ch.data(0, KEY) not in want:
                self._forget(t, ch); parent.takeChild(i)
        for i, r in enumerate(rows):                              # insert new rows in place
            key, cols = r[0], r[1]
            ch = parent.child(i) if i < parent.childCount() else None
            if ch is not None and ch.data(0, KEY) == key:
                it = ch
            else:
                it = t._items.get(key)
                if it is not None:                                # it was somewhere else: move it
                    par = it.parent() or t.invisibleRootItem()
                    par.takeChild(par.indexOfChild(it))
                else:
                    it = QTreeWidgetItem(cols); it.setData(0, KEY, key); t._items[key] = it
                parent.insertChild(i, it)
            kids = r[4] if len(r) > 4 else None
            self._sync(t, tab, it, kids or [])
            if kids:
                it.setExpanded((tab, key) in self.open_arrays)

    def _update(self, t, rows):
        for r in rows:
            key, cols, payload, color = r[:4]
            it = t._items[key]
            for c, v in enumerate(cols):
                if c in t._xcols:
                    continue
                if it.text(c) != v:
                    it.setText(c, v)
                it.setData(c, Qt.ItemDataRole.ForegroundRole, color if (color and c == t._color_col) else None)
            it.setData(0, Qt.ItemDataRole.UserRole, payload)
            if payload and (payload.get("tip") or payload.get("cmd")):
                tip = payload.get("tip") or payload["cmd"]
                for c in range(len(cols)):
                    if c not in t._xcols:
                        it.setToolTip(c, tip)
            if len(r) > 4 and r[4]:
                self._update(t, r[4])

    def clear_selection(self):
        self.sel = None; self.out.clear(); self.title.setText(NO_SEL)
        self.set_stream_buttons(None)

    # ── ✓ (remove from the history) and 🗑 (remove and delete its logs) on the row under the mouse ──
    def hover_target(self, t, it):
        """-> ("row", key, payload) for a job / array, ("group", name) for a Local / cluster header, or None."""
        if it is None:
            return None
        p = it.data(0, Qt.ItemDataRole.UserRole)
        if p:
            return ("row", it.data(0, Qt.ItemDataRole.UserRole + 3))
        g = it.data(0, Qt.ItemDataRole.UserRole + 1)
        return ("group", g) if g else None

    def hover_item(self, t, it):
        tgt = self.hover_target(t, it)
        if tgt is None:
            self.unhover(); return
        self._hover = (t, tgt)
        if self.hover_box is not None and self.hover_box.parent() is not t.viewport():
            self.hover_box.hide()
        self.hover_box = getattr(t, "_hover_box", None)
        if self.hover_box is None:
            box = QWidget(t.viewport()); t._hover_box = box; lay = QHBoxLayout(box); lay.setContentsMargins(0, 0, 4, 0); lay.setSpacing(2)
            box.btns = []
            for txt, color, delete in (("✓", "#2e9e48", False), ("🗑", "#d04040", True)):
                b = QToolButton(box); b.setText(txt); b.setAutoRaise(True)
                b.setStyleSheet(f"QToolButton {{ color: {color}; font-weight: bold; padding: 0 4px; }}")
                b.setCursor(Qt.CursorShape.PointingHandCursor)
                b.clicked.connect(lambda _, d=delete: self.hover_action(d))
                lay.addWidget(b); box.btns.append(b)
            self.hover_box = box
        group = tgt[0] == "group"
        what = (f"all the jobs of {tgt[1]}" if group else "this job")
        self.hover_box.btns[0].setToolTip(f"Remove {what} from the history (logs are kept)")
        self.hover_box.btns[1].setToolTip(f"Remove {what} from the history and delete {'their logs' if group else 'its log'} "
                                          f"(temporary local logs, or the .out/.err on the cluster; logs saved with -l "
                                          f"are never deleted)")
        self.place_hover()

    def hover_item_of(self, t, tgt):
        return t._items.get(tgt[1]) if tgt[0] == "row" else t._groups.get(tgt[1])

    def place_hover(self):
        """Put the ✓ / 🗑 buttons at the right end of the hovered row (it may have moved after a refresh)."""
        if not self._hover or self.hover_box is None:
            return
        t, tgt = self._hover
        it = self.hover_item_of(t, tgt)
        r = t.visualItemRect(it) if it is not None else None
        if r is None or not r.isValid() or r.height() <= 0:
            self.unhover(); return
        box = self.hover_box
        h = r.height(); [b.setFixedHeight(h) for b in box.btns]
        box.adjustSize()
        box.setGeometry(t.viewport().width() - box.width(), r.top(), box.width(), h)
        box.show(); box.raise_()

    def unhover(self):
        self._hover = None
        if self.hover_box is not None:
            self.hover_box.hide()

    def eventFilter(self, obj, ev):
        for t in (self.hist_l, self.hist_c):
            if obj is t.viewport():
                if ev.type() == ev.Type.Leave:
                    if self.hover_box is None or not self.hover_box.underMouse():
                        self.unhover()
                elif ev.type() == ev.Type.MouseMove:
                    it = t.itemAt(ev.position().toPoint())
                    tgt = self.hover_target(t, it)
                    if tgt is None:
                        self.unhover()
                    elif not self._hover or self._hover != (t, tgt):
                        self.hover_item(t, it)
                elif ev.type() == ev.Type.Resize:
                    self.place_hover()
        return False

    def hover_action(self, delete):
        if not self._hover:
            return
        t, tgt = self._hover
        it = self.hover_item_of(t, tgt)
        p = it.data(0, Qt.ItemDataRole.UserRole) if it is not None else None
        self.unhover()
        # Act once Qt has finished handling the click: refresh() rebuilds parts of the tree (crash otherwise).
        if tgt[0] == "group":
            QTimer.singleShot(0, lambda: self.clear_history(delete, only=tgt[1]))
        elif p:
            QTimer.singleShot(0, lambda: self.remove_from_history(p, delete))

    def delete_remote_logs(self, c, ids):
        """Delete those jobs' .out/.err on the cluster (in the background) and notify the result."""
        s = self.cstate.get(c["name"])
        ids = list(dict.fromkeys(ids))
        if not ids:
            return

        def run():
            paths, skipped, unknown = [], 0, 0
            for k in range(0, len(ids), 100):
                chunk = ids[k:k + 100]
                try:
                    info = resolve_logs(c["host"], c.get("pre", ""), chunk)
                except OSError:
                    info = {}
                for jid in chunk:
                    pp = info.get(jid) or (s.log_paths.get(jid) if s else None)
                    if not pp:
                        unknown += 1; continue
                    for path in dict.fromkeys([pp["out"], pp["err"]]):
                        if own_log(path, jid):
                            paths.append(path)
                        else:
                            skipped += 1
            n = 0
            for k in range(0, len(paths), 200):
                chunk = paths[k:k + 200]
                q = " ".join(shlex.quote(x) for x in chunk)
                ok, out, err = ssh_run(c["host"], f"for f in {q}; do [ -f \"$f\" ] && rm -f -- \"$f\" && echo @@DEL; done",
                                       timeout=120, pre=c.get("pre", ""))
                n += out.count("@@DEL") if ok else 0
            body = f"{n} .out/.err file(s) deleted"
            if skipped:
                body += f"; {skipped} kept because their name does not contain the job number (they might be shared)"
            if unknown:
                body += f"; for {unknown} job(s) Slurm no longer knows where the logs were"
            notify(f"{c['name']}: logs deleted", body)
            if s:
                for jid in ids:
                    s.log_paths.pop(jid, None)
                    s.logs.pop((jid, "out"), None); s.logs.pop((jid, "err"), None)
        threading.Thread(target=run, daemon=True).start()

    def remove_from_history(self, p, delete=False):
        """✓: only out of the list.  🗑: also delete its logs (temporary local log / .out and .err on the cluster)."""
        if p["kind"] == "local":
            remove_history_entry(p, delete_log=delete)
        else:
            c, s = self.cluster(p["cluster"]), self.cstate.get(p["cluster"])
            if c:
                known = {r["id"] for r in s.hist} if s and s.ok else None
                ids = p.get("ids") or [p["id"]]
                c["hidden"] = [i for i in c.get("hidden", []) if known is None or i in known] + ids
                save_clusters(self.clusters)
                if delete:
                    self.delete_remote_logs(c, ids)
        if delete:
            self.close_log_tabs(lambda i: i.get("key") == p.get("key") or
                                (p.get("ids") and i.get("cluster") == p.get("cluster") and i.get("id") in p["ids"]))
        self.refresh()

    def cluster_head(self, c, n):
        s = self.cstate.get(c["name"])
        if not s or s.first:
            return f"{c['name']}   ·   connecting…"
        if not s.ok:
            return f"{c['name']}   ·   not connected (right-click > Connect…)   ·   {s.err[:80]}"
        return f"{c['name']}   ·   {n}   ·   {time.strftime('%H:%M:%S', time.localtime(s.t))}"

    def hist_match(self, *texts, error=False):
        """History filter: search box text and 'All / Errors only / OK only'."""
        f = self.hfilter.currentIndex()
        if (f == 1 and not error) or (f == 2 and error):
            return False
        q = self.hsearch.text().strip().lower()
        return not q or any(q in str(x).lower() for x in texts)

    def local_rows(self, jobs):
        """Local rows of "Running" with the RAM, CPU and GPU of each job (summed over its child processes)."""
        table = proc_table(); kids = {}
        for pid, (pp, _, _) in table.items():
            kids.setdefault(pp, []).append(pid)
        gstat, gpid = gpu_info()
        now = time.time(); rows, seen = [], set()
        same = {}
        for j in jobs:
            same.setdefault((j["cmd"], j["cwd"]), []).append(j["label"])
        for j in jobs:
            key = ("local", j["label"], j["pid"]); seen.add(key)
            pids = tree_of(j["pid"], table, kids)
            rss = sum(table[p][1] for p in pids); ticks = sum(table[p][2] for p in pids)
            gpu = sum(gpid.get(p, 0) for p in pids)
            prev = self.prev_ticks.get(key)
            cpu = f"{max(0, ticks - prev[0]) / CLK / max(now - prev[1], 1e-3):.1f} cores" if prev else "…"
            self.prev_ticks[key] = (ticks, now)
            dups = [x for x in same[(j["cmd"], j["cwd"])] if x != j["label"]]
            tip = j["cmd"] + (f"\n\n⚠ DUPLICATE: the same command, in the same folder, is also running as: "
                              f"{', '.join(dups)}" if dups else "")
            rows.append((key, [f"● {j['label']}", fmt_dt(now - j["start"]), fmt_bytes(rss), cpu,
                               fmt_bytes(gpu) if gpu else "—", "⚠ duplicate" if dups else "running"],
                         dict(j, kind="local", key=key, tip=tip), ORANGE if dups else None))
        for k in [k for k in self.prev_ticks if k not in seen]:
            del self.prev_ticks[k]
        return rows, gstat

    def cluster_run_rows(self, c, s):
        """Rows of one cluster in "Running"; the tasks of a job array are grouped in one expandable row."""
        entries = [r for r in s.running if S["show_pending"] or r["state"] != "PENDING"]
        by_arr = {}
        for r in entries:
            if array_of(r["id"]):
                by_arr.setdefault(array_of(r["id"]), []).append(r)

        def task_row(r):
            key = (c["name"], r["id"])
            st = SLURM_CODE.get(r["state"], r["state"])
            if r["state"] == "PENDING" and r["reason"].strip("()") not in ("", "None"):
                st += f" ({r['reason'].strip('()')})"
            est = time.strftime("%d-%m %H:%M", time.localtime(s.starts[r["id"]])) if r["id"] in s.starts else ""
            return (key, [f"● {r['name']}  [{r['id']}]", r["used"] if r["state"] != "PENDING" else "", "", "",
                          r.get("gpu", ""), st, est,
                          r.get("part", "")],
                    dict(kind="cluster", cluster=c["name"], id=r["id"], label=r["name"], running=True, key=key,
                         cmd=f"{r['nodes']} node(s), time limit {r['limit']}" + (f", {r['reason']}" if r["state"] == "RUNNING" else "")),
                    GREY if r["state"] == "PENDING" else None)
        rows, done_groups = [], set()
        for r in entries:
            arr = array_of(r["id"])
            if not arr or len(by_arr[arr]) < 2:
                rows.append(task_row(r)); continue
            if arr in done_groups:
                continue
            done_groups.add(arr)
            tasks = by_arr[arr]
            n_run = sum(1 for t in tasks if t["state"] != "PENDING")
            n_pd = sum(array_task_count(t["id"]) for t in tasks if t["state"] == "PENDING")
            n_done = sum(1 for h in s.hist if array_of(h["id"]) == arr)
            total = n_run + n_pd + n_done
            used = max((t["used"] for t in tasks if t["state"] != "PENDING"), key=lambda u: slurm_secs(u) or 0, default="")
            key = (c["name"], "array", arr)
            ests = [s.starts[t["id"]] for t in tasks if t["id"] in s.starts]
            est = time.strftime("%d-%m %H:%M", time.localtime(min(ests))) if ests else ""
            rows.append((key, [f"● {tasks[0]['name']}  [{arr}]  · array", used, "", "", "",
                               f"{n_done}/{total} done · {n_run} R · {n_pd} PD", est,
                               ", ".join(dict.fromkeys(t.get("part", "") for t in tasks if t.get("part")))],
                         dict(kind="array", cluster=c["name"], id=arr, label=tasks[0]["name"], running=True, key=key,
                              ids=[t["id"] for t in tasks],
                              cmd=f"Array {arr}: {total} tasks ({n_done} finished, {n_run} running, {n_pd} queued)"),
                         GREY if not n_run else None, [task_row(t) for t in tasks]))
        return rows

    def cluster_hist_rows(self, c, s):
        """Rows of one cluster in "History" (filtered); job arrays are grouped in one expandable row."""
        items = []
        for r in sorted(s.hist, key=lambda r: r["end"], reverse=True):
            if r["end"] <= c.get("cleared", 0) or r["id"] in c.get("hidden", ()):
                continue
            txt = slurm_end_text(r["state"], r["exit"])
            if not self.hist_match(r["name"], r["id"], txt, r["state"], error=txt != "ok"):
                continue
            items.append((r, txt))

        def task_row(r, txt):
            key = (c["name"], r["id"])
            return (key, [f"{r['name']}  [{r['id']}]", r.get("part", ""), time.strftime("%d-%m %H:%M", time.localtime(r["end"])),
                          fmt_dt(r["elapsed"]) if r["elapsed"] is not None else "?", txt],
                    dict(kind="cluster", cluster=c["name"], id=r["id"], label=r["name"], running=False, key=key,
                         cmd=f"Slurm state: {r['state']}, ExitCode {r['exit']}"),
                    RED if txt != "ok" else None)
        by_arr = {}
        for r, txt in items:
            if array_of(r["id"]):
                by_arr.setdefault(array_of(r["id"]), []).append((r, txt))
        rows, done_groups = [], set()
        for r, txt in items:
            arr = array_of(r["id"])
            if not arr or len(by_arr[arr]) < 2:
                rows.append(task_row(r, txt)); continue
            if arr in done_groups:
                continue
            done_groups.add(arr)
            tasks = sorted(by_arr[arr], key=lambda x: int(x[0]["id"].split("_")[1]) if x[0]["id"].split("_")[1].isdigit() else 0)
            n_err = sum(1 for _, t in tasks if t != "ok")
            end = max(x["end"] for x, _ in tasks)
            dur = max((x["elapsed"] or 0) for x, _ in tasks)
            key = (c["name"], "array", arr)
            rows.append((key, [f"{tasks[0][0]['name']}  [{arr}]  · array of {len(tasks)}",
                               ", ".join(dict.fromkeys(x.get("part", "") for x, _ in tasks if x.get("part"))),
                               time.strftime("%d-%m %H:%M", time.localtime(end)), fmt_dt(dur),
                               "ok" if not n_err else f"{n_err} failed"],
                         dict(kind="array", cluster=c["name"], id=arr, label=tasks[0][0]["name"], running=False, key=key,
                              ids=[x["id"] for x, _ in tasks],
                              cmd=f"Array {arr}: {len(tasks)} tasks, {n_err} failed (duration = that of the longest task)"),
                         RED if n_err else None, [task_row(x, t) for x, t in tasks]))
        return rows

    def refresh(self):
        for c in self.clusters:
            self.poll_cluster(c)
        jobs = running_jobs()
        self.check_finished(jobs)
        n_cl = sum(len(self.cstate[c["name"]].running) for c in self.clusters if c["name"] in self.cstate)
        self.update_tray(len(jobs), sum(1 for c in self.clusters if c["name"] in self.cstate
                                        for r in self.cstate[c["name"]].running if r["state"] != "PENDING"))

        # running
        rows, gstat = self.local_rows(jobs)
        mem = meminfo()
        self.status.setText(f"{time.strftime('%H:%M:%S')}    "
                            + (f"RAM {mem[0] / 2 ** 30:.1f}/{mem[1] / 2 ** 30:.1f} GB    " if mem else "")
                            + f"{gstat}    |    {len(jobs)} running locally"
                            + (f",  {n_cl} on clusters" if self.clusters else ""))
        if not rows and not self.clusters:
            rows.append((("none",), ["Nothing running.", "", "", "", "", "", "", ""], None, None))
        self.fill(self.run_l, "run", [("Local", f"Local   ·   {len(jobs)} running", rows)], flat=not self.clusters)
        groups = []
        for c in self.clusters:
            s = self.cstate[c["name"]]
            crow = self.cluster_run_rows(c, s)
            n_run = sum(1 for r in s.running if r["state"] != "PENDING")
            n_pd = sum(array_task_count(r["id"]) for r in s.running if r["state"] == "PENDING")
            groups.append((c["name"], self.cluster_head(c, f"{n_run} running, {n_pd} queued"), crow))
        self.run_c.setVisible(bool(self.clusters))
        if self.clusters:
            self.fill(self.run_c, "run", groups, flat=False)
        self.fit_local()

        # history
        rows = []
        for r in history():
            ex = r.get("exit", "?")
            if not self.hist_match(r.get("label", ""), r.get("cmd", ""), local_exit_text(ex), error=ex != 0):
                continue
            key = ("local", r.get("label"), r.get("end"))
            rows.append((key, [r.get("label", "?"), "", time.strftime("%d-%m %H:%M", time.localtime(r.get("end", 0))),
                               fmt_dt(r.get("end", 0) - r.get("start", 0)), local_exit_text(ex)],
                         dict(r, kind="local", key=key), RED if ex != 0 else None))
        if not rows and not self.clusters:
            rows.append((("none",), ["No finished jobs.", "", "", "", ""], None, None))
        self.update_cluster_info()
        self.fill(self.hist_l, "hist", [("Local", f"Local   ·   {len(rows)}", rows)], flat=not self.clusters)
        groups = []
        for c in self.clusters:
            s = self.cstate[c["name"]]
            crow = self.cluster_hist_rows(c, s)
            n = sum(len(r[4]) if len(r) > 4 else 1 for r in crow)
            groups.append((c["name"], self.cluster_head(c, f"{n} (last {cset(c, 'hist_days')} days)"), crow))
        self.hist_c.setVisible(bool(self.clusters))
        if self.clusters:
            self.fill(self.hist_c, "hist", groups, flat=False)
        self.fit_local()
        self.place_hover()
        self.refresh_tabs()
        self.show_log()

