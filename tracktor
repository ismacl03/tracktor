        w.queue.setSortingEnabled(False); w.queue.clear()
        bold = w.queue.font(); bold.setBold(True)
        for q in i["queue"][:5000]:
            g = q.get("gpu", "")
            if g.startswith(q["reason"] + " · ") and ", " not in g:     # the node is already in the last column
                g = g[len(q["reason"]) + 3:]
            it = QTreeWidgetItem([q["id"], q["user"], q["part"], q["name"], SLURM_CODE.get(q["state"], q["state"]),
                                  q["used"] if q["state"] != "PENDING" else "", q["limit"], q["nodes"],
                                  g, q["reason"].strip("()")])
            if q["mine"]:
                for k in range(len(self.QUEUE_COLS)):
                    it.setFont(k, bold)
            if q["state"] == "PENDING":
                for k in range(len(self.QUEUE_COLS)):
                    it.setForeground(k, GREY)
            w.queue.addTopLevelItem(it)
        if w._sorted:
            w.queue.setSortingEnabled(True); w.queue.sortByColumn(col, order)
        else:       # first time: keep the order of the list (running first), but allow sorting by clicking headers
            h = w.queue.header(); h.blockSignals(True)
            h.setSortIndicator(-1, Qt.SortOrder.AscendingOrder); w.queue.setSortingEnabled(True)
            h.blockSignals(False)
        w.queue.setColumnHidden(self.QUEUE_COLS.index("GPUs"), not S["show_gpus"])
        w.queue.verticalScrollBar().setValue(vbar)

    # ── settings ──
    def apply_settings(self):
        self.timer.setInterval(S["local_every"] * 1000)
        self.run_c.setColumnHidden(4, not S["show_gpus"])        # clusters: GPU = node and GPU number(s)
        self.run_c.headerItem().setToolTip(4, "Node and GPU number(s) the job runs on (for queued jobs: how many "
                                              "GPUs it asks for)")
        self.setup_tray()
        f = self.out.font(); f.setPointSize(S["log_font"]); self.out.setFont(f)
        self.out.setLineWrapMode(QPlainTextEdit.LineWrapMode.WidgetWidth if S["wrap_log"]
                                 else QPlainTextEdit.LineWrapMode.NoWrap)

    def open_settings(self):
        d = SettingsDialog(self, self.clusters)
        if d.exec() != QDialog.DialogCode.Accepted:
            return
        old = dict(S); S.update(d.values()); save_settings(); self.apply_settings()
        vals, changed, repoll = d.cluster_values(), False, set()
        for c in self.clusters:
            for k, v in vals.get(c["name"], {}).items():
                if c.get(k) != v:
                    if k == "hist_days" and cset(c, k) != v:
                        repoll.add(c["name"])
                    c[k] = v; changed = True
        if changed:
            save_clusters(self.clusters)
        if S["tail_kb"] != old["tail_kb"]:
            for st in self.cstate.values():
                st.logs.clear()
        for c in self.clusters:
            if c["name"] in repoll:
                self.poll_cluster(c, force=True)
        self.refresh()
        if self.sel:
            self.select(self.sel)

    # ── notifications ──
    def check_finished(self, jobs):
        now = {(j["label"], j["pid"]): j for j in jobs}
        if self.prev_local is not None and S["notify_local"]:
            gone = [j for k, j in self.prev_local.items() if k not in now]
            if gone:
                hist = history()
                for j in gone:
                    r = next((r for r in hist if r.get("label") == j["label"] and r.get("start") == j["start"]), None)
                    ex = r.get("exit") if r else None
                    if ex == 0 and not S["notify_ok"]:
                        continue
                    txt = local_exit_text(ex) if ex is not None else "finished"
                    notify(f"{j['label']}: {txt}", f"Local · {fmt_dt(time.time() - j['start'])}",
                           error=ex not in (0, None))
        self.prev_local = now
        for c in self.clusters:
            s = self.cstate.get(c["name"])
            if not s or not s.ok:
                continue
            prev = self.prev_cluster.get(c["name"])
            if prev is not None and prev[0] == s.t:
                continue          # no new query yet
            ids = {r["id"]: r for r in s.running}
            if prev is not None and S["notify_start"]:     # PD -> R (or an array task that just started)
                started = [r for jid, r in ids.items() if r["state"] == "RUNNING"
                           and (jid not in prev[1] or prev[1][jid]["state"] == "PENDING")]
                if 0 < len(started) <= 3:
                    for r in started:
                        notify(f"{r['name']}: started", f"{c['name']} · job {r['id']}"
                               + (f" · {r.get('part')}" if r.get("part") else ""))
                elif started:
                    names = ", ".join(dict.fromkeys(r["name"] for r in started))
                    notify(f"{c['name']}: {len(started)} jobs started", names[:200])
            waiting = prev[2] if prev else {}
            if prev is not None:
                for jid, r in prev[1].items():
                    if jid not in ids and r["state"] != "PENDING":
                        waiting[jid] = (r, 0)
            hist = {r["id"]: r for r in s.hist}
            for jid, (r, tries) in list(waiting.items()):
                h = hist.get(jid)
                if h or tries >= 3:
                    del waiting[jid]
                    txt = slurm_end_text(h["state"], h["exit"]) if h else "finished"
                    if S["notify_cluster"] and (txt != "ok" or S["notify_ok"]):
                        notify(f"{r['name']}: {txt}", f"{c['name']} · job {jid}", error=txt not in ("ok", "finished"))
                else:
                    waiting[jid] = (r, tries + 1)
            self.prev_cluster[c["name"]] = (s.t, ids, waiting)

    # ── right-click menus ──
    def context_menu(self, t, pos):
        it = t.itemAt(pos)
        if not it:
            return
        g = it.data(0, Qt.ItemDataRole.UserRole + 1)
        p = it.data(0, Qt.ItemDataRole.UserRole)
        menu = QMenu(self); acts = {}
        if g and g != "Local":
            c = self.cluster(g)
            acts[menu.addAction("Refresh now")] = lambda: self.poll_cluster(c, force=True)
            if t is self.run_c:
                acts[menu.addAction("Show cluster status")] = lambda: self.show_cluster_info(c)
            st = self.cstate.get(c["name"])
            if st and st.ok:
                acts[menu.addAction("Disconnect")] = lambda: self.disconnect_cluster(c)
            else:
                acts[menu.addAction("Connect… (log in from a terminal)")] = lambda: self.connect(c)
            menu.addSeparator()
            acts[menu.addAction("Edit…")] = lambda: self.edit_cluster(c)
            acts[menu.addAction("Remove cluster")] = lambda: self.remove_cluster(c)
        elif p and t in (self.run_l, self.run_c) and p["kind"] == "local":
            acts[menu.addAction("Terminate (SIGTERM)")] = lambda: self.stop(p, signal.SIGTERM, "Terminate")
            acts[menu.addAction("Kill (SIGKILL)")] = lambda: self.stop(p, signal.SIGKILL, "Kill")
        elif p and t in (self.run_l, self.run_c) and p["kind"] == "cluster":
            acts[menu.addAction("Cancel (scancel)")] = lambda: self.scancel(p)
        elif p and t in (self.run_l, self.run_c) and p["kind"] == "array":
            acts[menu.addAction(f"Cancel the whole array {p['id']} (scancel)")] = lambda: self.scancel(p)
        elif p and t in (self.hist_l, self.hist_c) and p["kind"] == "local":
            acts[menu.addAction("Run again…")] = lambda: self.relaunch(p)
        if not acts:
            return
        a = menu.exec(t.viewport().mapToGlobal(pos))
        if a in acts:
            acts[a]()

    def stop(self, j, sig, verb):
        if not alive(j["pid"]):
            self.refresh(); return
        if not ask(self, verb, f"{verb} «{j['label']}»?\n\n{j['cmd']}"):
            return
        try:
            stop_job(j["pid"], sig)
        except PermissionError:
            tell(self, verb, "Not allowed to send a signal to that process (or it is not a job started with track).")
        QTimer.singleShot(500, self.refresh)

    def relaunch(self, r):
        """Run a local job from the history again with `track`, in its folder, registering it in the same list."""
        track = shutil.which("track") or os.path.expanduser("~/.local/bin/track")
        if not os.path.exists(track):
            tell(self, "Run again", "`track` not found (did you run install.sh?)."); return
        argv, cmd, d = r.get("argv", ""), r.get("cmd", ""), r["_dir"]
        cwd = r.get("cwd") or os.path.expanduser("~")
        log = r.get("log", "")
        temp = log.startswith(os.path.join(d, "logs") + os.sep)
        busy = {j["label"] for j in running_jobs()}
        base = label = r.get("label", "job"); k = 2
        while label in busy:
            label = f"{base}-{k}"; k += 1
        box = QMessageBox(self); box.setWindowTitle("Run again"); box.setIcon(QMessageBox.Icon.Question)
        text = f"Run «{base}» again?\n\nCommand (exactly as it will be run):\n{argv or cmd}\n\nFolder:  {cwd}"
        if label != base:
            text += f"\nLabel:  {label}  (one with the same name is already running)"
        if not argv:
            text += ("\n\nThis is an old job: the command is run again as it was saved (check it if it had arguments "
                     "with spaces or quotes).")
        if not temp and log:
            text += f"\n\nIts log was permanent: {log}"
        box.setText(text)
        keep = box.addButton("Run, overwriting that log", QMessageBox.ButtonRole.AcceptRole) if (log and not temp) else None
        go = box.addButton("Run with a new temporary log" if keep else "Run", QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        b = box.clickedButton()
        if b is not go and (keep is None or b is not keep):
            return
        opts = f"-l {shlex.quote(log)} " if (keep is not None and b is keep) else ""
        line = f"exec {shlex.quote(track)} {opts}{shlex.quote(label)} {argv or cmd}"
        subprocess.Popen(["bash", "-c", line], cwd=cwd if os.path.isdir(cwd) else None,
                         env=dict(os.environ, TRACKTOR_DIR=d), start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.tabs.setCurrentIndex(0)
        QTimer.singleShot(800, self.refresh)

    def scancel(self, p):
        c = self.cluster(p["cluster"])
        if not c or not ask(self, "Cancel", f"Cancel «{p['label']}» (job {p['id']}) on "
                                         f"{c['name']}?"):
            return
        res = {}

        def run():
            res["r"] = ssh_run(c["host"], f"scancel {shlex.quote(p['id'])} 2>&1", timeout=30, pre=c.get("pre", ""))
        th = threading.Thread(target=run, daemon=True); th.start()

        def done():
            if th.is_alive():
                QTimer.singleShot(300, done); return
            ok, out, err = res["r"]
            if not ok or out.strip():
                tell(self, "Cancel", f"scancel: {(out.strip() or err)}")
            self.poll_cluster(c, force=True)
        QTimer.singleShot(300, done)

    # ── system tray ──
    def setup_tray(self):
        global TRAY
        want = S["tray"] and QSystemTrayIcon.isSystemTrayAvailable()
        if want and self.tray is None:
            self.tray = QSystemTrayIcon(tray_icon(0), self)
            m = QMenu(self)
            m.addAction("Show window").triggered.connect(self.show_window)
            m.addSeparator()
            m.addAction("Quit").triggered.connect(self.quit_app)
            self.tray.setContextMenu(m)
            self.tray.activated.connect(lambda r: self.toggle_window() if r == QSystemTrayIcon.ActivationReason.Trigger else None)
            self.tray.setToolTip(APP); self.tray.show(); self._tray_n = None
        elif not want and self.tray is not None:
            self.tray.hide(); self.tray.deleteLater(); self.tray = None
        TRAY = self.tray

    def update_tray(self, n_local, n_cluster):
        """Number of running jobs (queued cluster jobs not counted) on the tray icon and on the taskbar icon."""
        n = n_local + n_cluster
        if n != getattr(self, "_taskbar_n", None):
            taskbar_count(n); self._taskbar_n = n
        if self.tray is None:
            return
        if n != self._tray_n:
            self.tray.setIcon(tray_icon(n)); self._tray_n = n
        self.tray.setToolTip(f"{APP}: {n_local} running locally" + (f", {n_cluster} on clusters" if self.clusters else ""))

    def show_window(self):
        self.showNormal(); self.raise_(); self.activateWindow()

    def toggle_window(self):
        if self.isVisible() and not self.isMinimized():
            self.hide()
        else:
            self.show_window()

    def quit_app(self):
        self._quitting = True
        self.close()

    def disconnect_cluster(self, c):
        disconnect(c)
        st = self.cstate.get(c["name"])
        if st:
            st.ok, st.err = False, "connection closed"
        self.refresh()

    def connect(self, c):
        if not connect_in_terminal(c):
            tell(self, "Connect", "No terminal emulator found.  Open one and run:\n\n"
                 + " ".join(shlex.quote(x) for x in [SSH, *ssh_opts("yes", f"{cset(c, 'persist_hours')}h"), c["host"], "true"]),
                 QMessageBox.Icon.Information)
            return
        s = self.cstate.get(c["name"])
        # retry a few times while the user logs in
        for k in range(1, 13):
            QTimer.singleShot(k * 5000, lambda: self.poll_cluster(c, force=not (s and s.ok)))

    # ── add / edit / remove clusters ──
    def add_cluster(self):
        d = ClusterDialog(self, taken=[c["name"] for c in self.clusters])
        if d.exec() != QDialog.DialogCode.Accepted:
            return
        c = d.value(); self.clusters.append(c); save_clusters(self.clusters)
        self.cstate[c["name"]] = ClusterState()
        self.refresh()

    def edit_cluster(self, c):
        d = ClusterDialog(self, existing=c, taken=[x["name"] for x in self.clusters if x is not c])
        if d.exec() != QDialog.DialogCode.Accepted:
            return
        v = d.value()
        self.cstate.pop(c["name"], None)
        c.update(v); save_clusters(self.clusters)
        self.cstate[c["name"]] = ClusterState()
        self.refresh()

    def remove_cluster(self, c):
        if not ask(self, "Remove cluster", f"Remove «{c['name']}» from the window?\n(Nothing is changed "
                                f"on the cluster or in your ~/.ssh/config.)"):
            return
        self.clusters.remove(c); save_clusters(self.clusters); self.cstate.pop(c["name"], None)
        self.close_log_tabs(lambda i: i.get("cluster") == c["name"])
        self.refresh()

    # ── closing and history ──
    def closeEvent(self, ev):
        # With the tray: closing the window only hides it (still watching and notifying); "Quit" in its menu exits.
        if self.tray is not None and not self._quitting:
            self.hide(); ev.ignore()
            if S["tray_notice"]:
                self.tray.showMessage(f"{APP} keeps running in the background",
                                      "Still watching and notifying from the system tray.  To quit completely: "
                                      "right-click the icon > Quit.")
            return
        # When really quitting, with the option on: leave nothing behind (cut running queries and close the master
        # connections).  Without it, the connections stay open until the configured idle time has passed.
        if S["close_on_exit"]:
            kill_active()
            close_all_masters()
        if self.tray is not None:
            self.tray.hide()
        super().closeEvent(ev)
        QTimer.singleShot(0, QApplication.quit)

    def clear_history(self, delete=False, only=None):
        """Clear history (✓): finished jobs out of the list, logs kept.  Delete history (🗑): also delete their logs
        (temporary local logs and the .out/.err on the clusters; -l logs are never deleted).  only = "Local" or the
        name of one cluster (the ✓ / 🗑 of a group header); None = everything."""
        local = only in (None, "Local")
        clusters = [c for c in self.clusters if only in (None, c["name"]) and c["name"] in self.cstate]
        visible = {c["name"]: [r["id"] for r in self.cstate[c["name"]].hist
                               if r["end"] > c.get("cleared", 0) and r["id"] not in c.get("hidden", ())]
                   for c in clusters}
        tmp = temp_logs() if (delete and local) else []
        where = "" if only is None else f" of {only}"
        if delete:
            title = "Delete history" + where
            msg = f"Remove all finished jobs{where} from the history AND delete their logs?\n\n"
            if local:
                msg += (f"Local: {len(tmp)} temporary log(s) will be deleted (jobs launched without -l).  Logs saved "
                        f"with -l and those of running jobs are not touched.\n" if tmp else
                        "Local: there are no temporary logs to delete.\n")
            if clusters:
                n = sum(len(v) for v in visible.values())
                msg += (f"\nClusters: the .out/.err of {n} finished job(s) will be deleted "
                        f"({', '.join(f'{k}: {len(v)}' for k, v in visible.items())}); only files whose name "
                        f"contains the job number.\n")
            msg += "\nThis cannot be undone."
        else:
            title = "Clear history" + where
            msg = (f"Remove all finished jobs{where} from the history?\n\nNothing is deleted: their logs stay where "
                   f"they are (use 🗑 / «Delete history» to also delete them).")
        if not ask(self, title, msg):
            return
        for p in tmp:
            try:
                os.remove(p)
            except OSError:
                pass
        if local:
            for d in job_dirs():
                p = os.path.join(d, "history.jsonl")
                if os.path.exists(p):
                    open(p, "w").close()
        now = time.time()
        for c in clusters:
            if delete and visible.get(c["name"]):
                self.delete_remote_logs(c, visible[c["name"]])
            c["cleared"] = now; c["hidden"] = []
        if clusters:
            save_clusters(self.clusters)
        if delete:      # close the tabs of the logs that no longer exist
            names = {c["name"] for c in clusters}
            self.close_log_tabs(lambda i: (i["kind"] == "local" and i.get("log") in tmp) or
                                (i["kind"] != "local" and i.get("cluster") in names and not i.get("running")))
        self.refresh()

def main():
    load_settings()
    app = QApplication(sys.argv)
    app.setApplicationName(APP)
    app.setDesktopFileName("tracktor")        # so the desktop shows the launcher's icon, not a generic one
    app.setWindowIcon(app_icon())
    app.setQuitOnLastWindowClosed(False)      # with the tray, closing the window does not quit
    # Single instance: if one is already running (e.g. hidden in the tray), ask it to show itself and exit.
    name = os.environ.get("TRACKTOR_INSTANCE", f"tracktor-{os.getuid()}")
    sock = QLocalSocket(); sock.connectToServer(name)
    if sock.waitForConnected(300):
        sock.write(b"show"); sock.flush(); sock.waitForBytesWritten(300)
        sys.exit(0)
    QLocalServer.removeServer(name)
    server = QLocalServer(); server.setSocketOptions(QLocalServer.SocketOption.UserAccessOption); server.listen(name)
    app.aboutToQuit.connect(lambda: taskbar_count(0))
    w = Main(); w.show()
    server.newConnection.connect(lambda: (server.nextPendingConnection(), w.show_window()))
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
