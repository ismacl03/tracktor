SLURM_END = {"COMPLETED": "ok", "CANCELLED": "cancelled", "TIMEOUT": "timeout", "OUT_OF_MEMORY": "out of memory",
             "NODE_FAIL": "node failure", "PREEMPTED": "preempted", "BOOT_FAIL": "boot failure",
