#!/usr/bin/python3
"""Tracktor launcher: runs the tracktor package from src/ next to this file (the repository) or from the installed
copy in ~/.local/share/tracktor/lib.  `tracktor --help` for the options."""
import os, sys

here = os.path.dirname(os.path.realpath(__file__))
for d in (os.path.join(here, "src"), os.path.expanduser("~/.local/share/tracktor/lib")):
    if os.path.isfile(os.path.join(d, "tracktor", "__init__.py")):
        sys.path.insert(0, d)
        break
else:
    sys.exit("tracktor: package not found (run install.sh again)")

from tracktor.app import main  # noqa: E402

main()
