#!/bin/bash
# track: run a command while registering it for Tracktor; when it ends it goes to the history.
# Usage:  track [-l <log>] <label> <command...>
#   without -l: output goes to ~/.local/state/tracktor/logs/<label>-<date>.log (temporary log: "Clear history"
#               in Tracktor deletes it)
#   with -l:    output goes to <log> (overwritten if it exists; Tracktor never deletes it)
# E.g.:  track N25 python train.py --N 25          track -l data/N25.log N25 python train.py --N 25
# Set TRACKTOR_DIR to register the job in another folder (e.g. a project's .jobs, listed in ~/.config/tracktor/dirs).
usage() { echo "usage: track [-l <log>] <label> <command...>"; exit 1; }
D=${TRACKTOR_DIR:-$HOME/.local/state/tracktor}
log=
if [ "$1" = "-l" ]; then [ $# -ge 2 ] || usage; log=$(realpath -m "$2"); shift 2; fi
[ $# -lt 2 ] && usage
label=$1; shift
[ -n "$log" ] || log="$D/logs/$label-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$D" "$(dirname "$log")"
f="$D/$label.job"; start=$(date +%s)
argv=$(printf '%q ' "$@")   # the command with its quoting, to run it again exactly
printf 'pid=%s\nstart=%s\nlog=%s\ncwd=%s\ncmd=%s\nargv=%s\n' "$$" "$start" "$log" "$PWD" "$*" "$argv" > "$f"
js() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "${s//$'\n'/ }"; }
finish() {
  st=${st:-130}
  printf '{"label":%s,"start":%s,"end":%s,"exit":%s,"log":%s,"cwd":%s,"cmd":%s,"argv":%s}\n' "$(js "$label")" \
    "$start" "$(date +%s)" "$st" "$(js "$log")" "$(js "$PWD")" "$(js "$cmd")" "$(js "$argv")" >> "$D/history.jsonl"
  rm -f "$f"
}
cmd="$*"
trap finish EXIT
trap 'st=143; exit 143' TERM INT
"$@" > "$log" 2>&1
st=$?
exit $st
